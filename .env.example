# ─── Google OAuth 2.0 Credentials ──────────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# The redirect URI registered in Google Cloud Console for OAuth
# For local auth flow, use: http://localhost:3000/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# ─── Token Storage ──────────────────────────────────────────────────────────
# Path where OAuth tokens are stored after first login (relative to project root)
# This file must be listed in .gitignore — never commit it
GOOGLE_TOKEN_STORAGE=.tokens/google-token.json

# ─── MCP Server ─────────────────────────────────────────────────────────────
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost

# ─── Logging ────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
