# ─── Google OAuth 2.0 Credentials ──────────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# For local dev:  http://localhost:3000/oauth/callback
# For Railway:    https://<your-app>.railway.app/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# ─── Token Storage ──────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT: tokens are stored in this file after running `npm run auth`
GOOGLE_TOKEN_STORAGE=.tokens/google-token.json

# RAILWAY / PRODUCTION: base64-encode your token file and paste here.
# Generate with:  cat .tokens/google-token.json | base64
# Leave empty for local dev (file-based storage is used instead).
GOOGLE_TOKEN_JSON=

# ─── MCP Server ─────────────────────────────────────────────────────────────
# Railway injects PORT automatically — do not set it manually on Railway.
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost

# ─── Security ────────────────────────────────────────────────────────────────
# Set a strong random secret to protect the /mcp endpoint on Railway.
# Clients must send:  x-api-key: <value>
# Leave empty to disable protection (not recommended for production).
# Generate with:  openssl rand -hex 32
MCP_API_KEY=

# ─── Logging ────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
